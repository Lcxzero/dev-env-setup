  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "chrome-devtools-mcp@latest"
      ],
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "command": [
        "/home/lcxzero/.local/bin/uvx",
        "mcp-server-fetch"
      ],
      "enabled": false
    },
    "edgeone-pages-mcp-server": {
      "type": "local",
      "command": [
        "npx",
        "edgeone-pages-mcp-fullstack@latest",
        "--region",
        "china"
      ],
      "timeout": 600000,
      "enabled": true
    },
    "bing-search": {
      "type": "local",
      "command": [
